<IfModule mod_headers.c>
  # Хешовані Vite-бандли (main-<hash>.js, main-<hash>.css тощо) — ім'я файлу унікальне,
  # тому кешуємо на рік без ревалідації при кожному візиті.
  <FilesMatch "-[A-Za-z0-9_]{6,12}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Інша статика без хешу в імені (фото, логотип, favicon, шрифти) — може оновлюватись
  # без зміни назви файлу, тому кеш коротший і з ревалідацією.
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|gif|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML і локальні demo/fallback CSV можуть змінюватись — не кешуємо на клієнті.
  <FilesMatch "\.(html|csv)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security-заголовки. img-src дозволяє будь-який https-хост — фото товарів вставляються
  # в Google Таблицю довільними посиланнями (postimg.cc, Google Drive тощо), список нема як
  # обмежити наперед. connect-src потребує *.googleusercontent.com — Sheets export CSV
  # (docs.google.com/.../export?format=csv) редіректить саме туди, без цього хоста фетч
  # блокується CSP і сайт мовчки падає на демо-дані.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://docs.google.com https://*.googleusercontent.com https://script.google.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
