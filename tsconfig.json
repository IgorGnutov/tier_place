{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // src/shared/*.mjs — плейн-ESM, спільний для клієнта і білд-скриптів (Node 20 у CI не
    // читає .ts). checkJs лишається false: strict-перевірка плейн-JS дала б шум без користі,
    // типи публічних функцій описані JSDoc-ом.
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "scripts"]
}
